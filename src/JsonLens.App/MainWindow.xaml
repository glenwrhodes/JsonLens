<Window x:Class="JsonLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JsonLens.App.Views"
        Title="{Binding WindowTitle}" Width="1400" Height="860" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource TitleBarBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="#FF3C3C3C" BorderThickness="1">
        <views:MainView x:Name="View" />
    </Border>
</Window>
