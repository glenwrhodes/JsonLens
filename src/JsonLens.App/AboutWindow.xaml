<Window x:Class="JsonLens.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About JSON Lens" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SidePanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" MouseLeftButtonDown="OnDrag">
        <StackPanel Margin="28,26,28,22">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="{}{ }" FontFamily="{StaticResource CodeFont}" FontWeight="Bold" FontSize="17"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="JSON Lens" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrightBrush}" />
                    <TextBlock x:Name="VersionText" Text="Version 1.0.0" Foreground="{StaticResource TextDimBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                       Text="A fast JSON explorer: a tree that stays quick on huge files, search, JSONPath queries (RFC 9535), copy path, and pretty or minified output." />
            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource TextDimBrush}" FontSize="12" LineHeight="19">
                <Run Text="Ctrl+O open · Ctrl+F search · Ctrl+L query" /><LineBreak />
                <Run Text="F3 / Shift+F3 next / previous match" /><LineBreak />
                <Run Text="Ctrl+C copy value · Ctrl+Shift+C copy path · Ctrl+S save as" />
            </TextBlock>
            <TextBlock Margin="0,18,0,0" Text="© 2026 Tiny Moosh Games Inc." Foreground="{StaticResource TextDimBrush}" />
            <Button Style="{StaticResource AccentButton}" Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0"
                    IsDefault="True" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Border>
</Window>
